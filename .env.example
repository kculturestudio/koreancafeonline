# Skopiuj do pliku .env (lokalnie) albo wpisz w Netlify → Site configuration → Environment variables.
# NIGDY nie wrzucaj prawdziwych kluczy do repozytorium.

# Stripe (najpierw używaj kluczy testowych: sk_test_..., price_...)
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=7

# Tylko lokalnie (na Netlify adres ustawia się sam):
# SITE_URL=http://localhost:8888

# Brama "Coming soon": hasło dla testerów i administratorów (sprawdzane na serwerze Netlify).
GATE_PASSWORD=
# Ustaw na true, żeby wyłączyć bramę (strona publiczna).
# GATE_OFF=true
